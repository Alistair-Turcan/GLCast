include LICENSE METHOD.md PROVENANCE.md SOURCE_HASHES.json CITATION.cff
include VALIDATION.md requirements-validated.txt CHANGELOG.md
recursive-include configs *.json
recursive-include examples *.py *.json *.csv *.md
recursive-include tests *.py
recursive-include notebooks *.ipynb
global-exclude *.py[cod]
prune build
prune dist
prune .pytest_cache
